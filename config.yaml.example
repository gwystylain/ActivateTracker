# activateTracker config.
# Copy to config.yaml, fill in real values, then `docker compose up -d`.

admin:
  username: admin
  # Generate with: docker compose run --rm activatetracker python -m app.tools.hashpw
  # (or, locally:) python -m app.tools.hashpw
  # Paste the resulting bcrypt hash here. NEVER commit a real value.
  password_bcrypt: "REPLACE_ME_WITH_BCRYPT_HASH"

session:
  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
  # Rotating this value invalidates all existing sessions.
  secret_key: "REPLACE_ME_WITH_64_HEX_CHARS"
  cookie_name: "atrk_session"
  max_age_hours: 24

poll:
  # "daily"  - run once a day at hour_utc
  # "manual" - never auto-poll (button only)
  # cron     - 5-field crontab, e.g. "0 11 * * *"
  schedule: "daily"
  hour_utc: 11                # 11:00 UTC ~= 04:00 Pacific
  request_timeout_sec: 20
  jitter_seconds: [0.5, 2.0]  # min/max random delay between requests
  user_agent: "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"

badges:
  # Badges are not on the score pages the poller scrapes — the site only shows
  # them on the in-store score-checker iPad. This is a community-run proxy in
  # front of an official Activate badge API, public and keyed on the handle
  # alone. It is somebody's personal server, so it is configuration: point it
  # elsewhere if it moves, or set enabled: false to skip badges entirely (the
  # dashboard's badge count then falls back to the score page's own tally).
  enabled: true
  # Moved here from api.ryflix.ca, which now answers 503. Same response shape;
  # the path is {api_base}/{handle}, and the request carries an Origin derived
  # from this URL because the host 403s without one.
  api_base: "https://www.activate-scores.ca/api/activate/badges"
  # Still its own spacing rather than sharing poll.jitter_seconds, since this is
  # the one leg that leaves playactivate.com. The old host allowed five handles
  # a minute; this one states X-RateLimit-Limit: 120 over a ~30s window, so a
  # couple of seconds apart is both quick and polite. A 429 is still waited out
  # rather than dropped — otherwise the handles at the back of the queue lose
  # every single night.
  spacing_seconds: [1.0, 3.0]    # min/max delay between badge requests
  max_retries: 3                 # retries after a 429 (other errors: none)
  backoff_seconds: 30.0          # first wait, doubling; a Retry-After wins
  max_wait_seconds: 120.0        # longer than this, give up: a poll holds a lock

server:
  # Number of trusted reverse-proxy hops in front of the app (e.g. nginx-proxy-manager = 1).
  trusted_proxy_hops: 1
  # Comma-separated CIDRs/IPs uvicorn will accept X-Forwarded-* from. "*" = all (only if behind a trusted proxy).
  forwarded_allow_ips: "*"
